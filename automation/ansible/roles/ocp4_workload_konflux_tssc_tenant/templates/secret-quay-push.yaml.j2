---
apiVersion: v1
kind: Secret
metadata:
  name: quay-push-secret
  namespace: {{ ocp4_workload_konflux_tssc_tenant_user }}-managed
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "{{ quay_registry_host }}": {
          "auth": "{{ (ocp4_workload_konflux_tssc_tenant_user + ':' + ocp4_workload_konflux_tssc_tenant_password) | b64encode }}"
        }
      }
    }
