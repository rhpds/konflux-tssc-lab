---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: quay-showroom
  namespace: quay-enterprise
spec:
  host: quay.{{ openshift_api_url | regex_replace('^https?://', '') | regex_replace(':[0-9]+$', '') | regex_replace('^api\\.', 'apps.') }}
  to:
    kind: Service
    name: quay-quay-app
    weight: 100
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None
