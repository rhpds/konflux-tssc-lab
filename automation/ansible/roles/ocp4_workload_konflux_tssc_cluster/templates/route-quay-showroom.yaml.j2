---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: quay-showroom
  namespace: quay-enterprise
spec:
  host: quay.{{ sandbox_openshift_apps_domain }}
  to:
    kind: Service
    name: quay-quay-app
    weight: 100
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None
